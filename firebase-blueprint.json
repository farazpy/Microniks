{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with contact info and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Order": {
      "title": "Order",
      "description": "Order placed by a customer or guest",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "userId": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "gstAmount": { "type": "number" },
        "total": { "type": "number" },
        "shipping": { "type": "object" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "items", "total", "shipping", "paymentMethod", "status", "createdAt"]
    },
    "DealerInquiry": {
      "title": "DealerInquiry",
      "description": "Dealer partnership inquiry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopName": { "type": "string" },
        "ownerName": { "type": "string" },
        "phone": { "type": "string" },
        "district": { "type": "string" },
        "taluka": { "type": "string" },
        "gstNumber": { "type": "string" },
        "annualTurnover": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["shopName", "ownerName", "phone", "district", "createdAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Contact message from customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "phone", "message", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents keyed by Auth UID"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders collection"
    },
    "/dealer_inquiries/{inquiryId}": {
      "schema": "DealerInquiry",
      "description": "Dealer inquiries"
    },
    "/contact_messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Contact form submissions"
    }
  }
}

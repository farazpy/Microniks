rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.auth.token.email == "micronikagri@gmail.com")
                  || !isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.auth.token.email == "micronikagri@gmail.com");
      allow delete: if isAuthenticated() && request.auth.token.email == "micronikagri@gmail.com";
    }

    match /dealer_inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }
  }
}
